# =================================================================
# MADHUR DASHBOARD — Environment Configuration
# =================================================================
# NOTE: MADHUR DASHBOARD works 100% out of the box with ZERO mandatory keys!
# All primary data providers (Open-Meteo Weather & Geocoding, Official
# Netflix Tudum TSV, Google News RSS, and Wikimedia Archives) are free,
# verified, reliable, and require no API key or subscription.
# =================================================================

# Server Port (Express proxy & static server in production)
PORT=3001

# Node Environment ('development' or 'production')
NODE_ENV=development

# Optional Frontend API URL override (defaults to '/api' via Vite proxy)
# VITE_API_URL=http://localhost:3001/api

# Optional: If you wish to configure alternative commercial weather providers
# VITE_OPENWEATHER_API_KEY=

# Optional: If you wish to configure alternative commercial news providers
# NEWS_API_KEY=

# Optional: If you wish to configure TMDB for alternative movie art
# TMDB_API_KEY=

